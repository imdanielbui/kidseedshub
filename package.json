{
  "name": "kidseedshub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "env:validate": "tsx scripts/validate-env.ts",
    "release:preflight": "tsx scripts/release-preflight.ts",
    "release:smoke": "tsx scripts/release-smoke.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed:demo": "KIDSEEDSHUB_SEED_MODE=demo tsx prisma/seed.ts",
    "prisma:seed:production": "KIDSEEDSHUB_SEED_MODE=production tsx prisma/seed.ts",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@prisma/client": "^6.0.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "next-auth": "5.0.0-beta.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.6",
    "gitnexus": "^1.6.5",
    "postcss": "^8.5.14",
    "prisma": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "^8.5.14",
    "exceljs": {
      "tmp": "^0.2.7",
      "uuid": "^11.1.1"
    }
  }
}
